{
  "description": "Load matching repository rules before file-related tool calls.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/path_rules.py\"",
            "timeout": 10,
            "statusMessage": "Resetting path-scoped rule context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/path_rules.py\"",
            "timeout": 10,
            "statusMessage": "Checking path-scoped rules",
            "additionalContextLimit": 12000
          }
        ]
      }
    ]
  }
}
